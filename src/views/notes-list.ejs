<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/webnotelogo.png">
  <title>My Notes</title>
</head>

<script src="/js/main.js" defer></script>

<body>
  <header>
    <nav>
      <div class="container">
        <a href="/" class="logo">
          <img src="/img/webnotelogo.png" alt="WebNote logo" width="15%">
        </a>
        <h1>Your Notes</h1>
        <ul class="nav-links"> <!-- these 3 links always show up -->
          <li><a href="/">Home</a></li>
          <li><a href="/users/about">About</a></li>
          <li><a href="/api/inspire">Inspiration</a></li>

          <% if (user) { %> <!-- these only show if user is logged in -->
            <li><a href="/notes">Notes</a></li>
            <li><a href="/notes/list">My Notes</a></li>
            <li><a href="/users/profile">Profile</a></li>
            <li><a href="/users/logout">Logout</a></li>

          <% } else { %> <!-- these only show if user is NOT logged in -->
            <li><a href="/users/login">Login</a></li>
            <li><a href="/users/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>
  <div class="list">
    <main class="container">
      <% if(notes.length === 0) { %>
        <p>No notes yet - create one!</p>
      <% } else { %>
        <ul>
          <% notes.forEach(note => { 
              const maxTitleLength = 30;
              const maxContentLength = 100;
              //trimming title
              let displayTitle = note.title;
              if (displayTitle.length > maxTitleLength) {displayTitle = displayTitle.substring(0, maxTitleLength) + '…';}
              //trimming content
              let displayContent = note.content;
              if (displayContent.length > maxContentLength) {displayContent = displayContent.substring(0, maxContentLength) + '…';}%>
            <li>
              <div class="note-top">
                <strong><%= displayTitle %></strong><br>
                <%= displayContent %>
              </div>
              <div class="note-bottom">
                <small class="note-time" data-utc="<%= note.created_at %>"></small>

                <div class="button-group">
                  <!-- edit button -->
                  <form action="/notes" method="GET" style="display:inline;">
                    <input type="hidden" name="id" value="<%= note.id %>">
                    <button type="submit">Edit/View</button>
                  </form>

                  <!-- delete button -->
                  <form action="/notes/<%= note.id %>/delete" method="POST" style="display:inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="delete-note-button" data-title="<%= JSON.stringify(note.title) %>">Delete</button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <a href="/notes">Add New Note</a>
    </main>
  </div>

  <footer>
    <div class="container">
      <p>&copy; 2025 CS346 Project. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
