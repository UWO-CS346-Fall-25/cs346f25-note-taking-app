<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/webnotelogo.png">
</head>
<body class="profile-page">
  <header>
    <nav>
      <div class="container">
        <a href="/" class="logo">
          <img src="/img/webnotelogo.png" alt="WebNote logo" width="15%">
        </a>
        <h1>Your Profile</h1>
        <ul class="nav-links"> <!-- these 3 links always show up -->
          <li><a href="/">Home</a></li>
          <li><a href="/users/about">About</a></li>
          <li><a href="/api/inspire">Inspiration</a></li>

          <% if (user) { %> <!-- these only show if user is logged in -->
            <li><a href="/notes">Notes</a></li>
            <li><a href="/notes/list">My Notes</a></li>
            <li><a href="/users/profile">Profile</a></li>
            <li><a href="/users/logout">Logout</a></li>

          <% } else { %> <!-- these only show if user is NOT logged in -->
            <li><a href="/users/login">Login</a></li>
            <li><a href="/users/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>

    <main class="container">
    <h1></h1>
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="error-banner"><%= error %></p>
      <% } %>

      <% if (typeof message !== 'undefined' && message) { %>
        <p class="success-banner"><%= message %></p>
      <% } %>
    <div class="card profile-card">
      <div class="profile-header">
        <div class="profile-avatar">
          <span><%= (user && user.name) ? user.name.charAt(0).toUpperCase() : 'U' %></span>
        </div>
        <div>
          <h2 class="profile-name"><%= user && user.name %></h2>
          <p class="profile-tagline">Manage your account details and get back to your notes.</p>
        </div>
      </div>

      <div class="profile-details">
        <div class="profile-field">
          <span class="profile-field-label">Email</span>
          <span class="profile-field-value"><%= user && user.email %></span>
        </div>
      </div>

      <!-- Update display name -->
      <section class="profile-section">
        <h2>Display Name</h2>
        <form action="/users/profile/name" method="POST" class="profile-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <input
              id="displayName"
              type="text"
              name="displayName"
              required
              minlength="2"
              value="<%= user && user.name %>"
            >
          </div>

          <button type="submit" class="btn">Update name</button>
        </form>
      </section>

      <!-- Change password -->
      <section class="profile-section">
        <h2>Change Password</h2>
        <form action="/users/profile/password" method="POST" class="profile-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-group">
            <label for="currentPassword">Current password</label>
            <input
              id="currentPassword"
              type="password"
              name="currentPassword"
              autocomplete="current-password"
            >
          </div>

          <div class="form-group">
            <label for="newPassword">New password</label>
            <input
              id="newPassword"
              type="password"
              name="newPassword"
              required
              minlength="6"
              autocomplete="new-password"
            >
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm new password</label>
            <input
              id="confirmPassword"
              type="password"
              name="confirmPassword"
              required
              minlength="6"
              autocomplete="new-password"
            >
          </div>

          <button type="submit" class="btn">Change password</button>
        </form>
      </section>


      <div class="profile-actions">
        <a class="btn" href="/users/logout">Logout</a>
      </div>
    </div>
  </main>


  <footer>
    <div class="container">
      <p>&copy; 2025 CS346 Project. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
